# Paste into Streamlit Community Cloud → App → Settings → Secrets (never commit real values).
# TOML rule: plain keys must come BEFORE any [section].

ADMIN_EMAIL = "you@gmail.com"            # your Google account — always an admin
# FIRST_GROUND_NAME = "Lewis/Klein Property"   # name for the ground created from existing data
APP_PASSWORD = "choose-a-password"       # only used until Google sign-in ([auth]) is configured

[storage]
github_token = "github_pat_..."          # fine-grained PAT: Contents read/write on deercast-data ONLY
repo = "jjpvoskuil/deercast-data"
branch = "main"
path = "data"

[auth]                                   # Google sign-in — see docs/GOOGLE_SIGNIN.md
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string"
client_id = "xxxxxxxx.apps.googleusercontent.com"
client_secret = "GOCSPX-..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
